<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Bind the SDK's TokenStore contract to Magento's DB-backed implementation -->
    <preference for="Waffy\Ecommerce\Contract\TokenStore"
                type="Waffy\Payment\Model\TokenStore"/>

    <!-- Note: the checkout config provider is registered in etc/frontend/di.xml,
         NOT here. Magento_Checkout declares CompositeConfigProvider's
         configProviders array in its own frontend-area di.xml, and an
         area-scoped argument replaces the global one wholesale — a global
         declaration here is silently dropped on the storefront. -->

    <!-- Register CLI commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="waffy_checkout_test" xsi:type="object">Waffy\Payment\Console\Command\TestCheckoutCommand</item>
            </argument>
        </arguments>
    </type>

</config>
