<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <waffy_payment>
                <active>0</active>
                <title>Pay with Waffy</title>
                <model>Waffy\Payment\Model\Payment</model>
                <!-- Fixed: new Waffy orders wait for payment; any country may use it. -->
                <order_status>pending_payment</order_status>
                <allowspecific>0</allowspecific>
                <environment>sandbox</environment>
                <payment_type>PURCHASE</payment_type>
                <!-- The connection ({sandbox|production}_*) is written by the setup
                     wizard (Stores → Waffy setup); return policy, category and the
                     milestone deadline are SDK defaults. -->
            </waffy_payment>
        </payment>
    </default>
</config>
