<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <waffy_payment>
                <active>0</active>
                <title>Pay with Waffy</title>
                <model>Waffy\Payment\Model\Payment</model>
                <order_status>pending_payment</order_status>
                <allowspecific>0</allowspecific>
                <environment>sandbox</environment>
                <sandbox_client_id></sandbox_client_id>
                <sandbox_client_secret></sandbox_client_secret>
                <production_client_id></production_client_id>
                <production_client_secret></production_client_secret>
                <merchant_phone></merchant_phone>
                <return_policy>NO_RETURN</return_policy>
                <return_fee_payee>PROVIDER</return_fee_payee>
                <is_deliverable>0</is_deliverable>
                <is_inspectable>0</is_inspectable>
                <is_acceptable>0</is_acceptable>
                <milestone_deadline_days>30</milestone_deadline_days>
                <category>Services</category>
                <payment_type>PURCHASE</payment_type>
                <!-- auth_base_url / api_base_url intentionally have no defaults:
                     empty means "derive from environment" (see Model\Config). -->
            </waffy_payment>
        </payment>
    </default>
</config>
